# ==============================================================================
# .env.example — Daily Close (ዕለታዊ ሂሳብ ማጠቃለያ)
# Birana Technology — Addis Ababa, Ethiopia
# Copy this file to .env and replace placeholders with secure random secrets.
# NEVER commit .env to source control (.gitignore protects it).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL application user connection (Role: app — Non-superuser, RLS enforced)
DATABASE_URL=postgresql+psycopg://app:REPLACE_WITH_STRONG_APP_PASSWORD@localhost:5432/dailyclose

# PostgreSQL migration connection (Role: postgres — Superuser to apply RLS DDL & REVOKE)
DATABASE_MIGRATION_URL=postgresql+psycopg://postgres:REPLACE_WITH_SUPERUSER_PASSWORD@localhost:5432/dailyclose

# Passwords for docker-compose and host services
DB_PASSWORD=REPLACE_WITH_STRONG_APP_PASSWORD
DB_SUPERUSER_PASSWORD=REPLACE_WITH_SUPERUSER_PASSWORD
POSTGRES_DB=dailyclose
POSTGRES_USER=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Security & Cryptography
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET_KEY

# age asymmetric encryption for nightly backups (deploy/backup_nightly.sh).
# Set ONE of the following (AGE_RECIPIENTS_FILE takes precedence):
#
#   AGE_RECIPIENTS_FILE — path to a file listing one age1... public key per line
#   (use this for multi-custodian key rotation without changing the env file).
#   Generate a key pair with: age-keygen -o offline_identity.txt
#   The public key line printed to stdout looks like: age1ql3z7hjy54...
#
#   AGE_RECIPIENT — a single age1... public key (simpler single-custodian setup).
#
# The corresponding private key (AGE-SECRET-KEY-1...) must be kept OFFLINE
# in air-gapped hardware custody. Never store the private key on the server.
AGE_RECIPIENTS_FILE=/etc/dailyclose/age_recipients.txt
# AGE_RECIPIENT=age1REPLACE_WITH_YOUR_AGE_PUBLIC_KEY

# IP address of the Nginx reverse proxy as seen from the uvicorn process.
# Default is 127.0.0.1 (loopback, correct for single-server deployments).
# Used by docker-compose as: --forwarded-allow-ips="${TRUSTED_PROXY_IP:-127.0.0.1}"
# Never set this to '*' in production; that allows X-Forwarded-For spoofing.
TRUSTED_PROXY_IP=127.0.0.1

# ------------------------------------------------------------------------------
# 3. Application & Logging Environment
# ------------------------------------------------------------------------------
# APP_ENV: development, test, production
APP_ENV=production

# LOG_LEVEL: INFO, WARNING, ERROR (Rule 9: Never use DEBUG in production to prevent PII leakage)
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 4. Telegram Bot Adapter (aiogram 3)
# ------------------------------------------------------------------------------
# Bot token acquired from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:REPLACE_WITH_YOUR_TELEGRAM_BOT_TOKEN
