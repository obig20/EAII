# Copy this file to .env and fill in values.
# .env is gitignored — NEVER commit it.

# PostgreSQL connection (app role, NOT superuser)
DATABASE_URL=postgresql+psycopg://app:changeme@localhost:5432/dailyclose
# Used by Alembic migrations (superuser to apply RLS + REVOKE)
DATABASE_MIGRATION_URL=postgresql+psycopg://postgres:changeme@localhost:5432/dailyclose

# Application secret (used for signed tokens; min 32 random bytes, hex-encoded)
SECRET_KEY=change-me-to-64-hex-chars

# DB password referenced in docker-compose.yml
DB_PASSWORD=changeme
DB_SUPERUSER_PASSWORD=changeme

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
