# ==============================================================================
# .env.example — Daily Close (ዕለታዊ ሂሳብ ማጠቃለያ)
# Birana Technology — Addis Ababa, Ethiopia
# Copy this file to .env and replace placeholders with secure random secrets.
# NEVER commit .env to source control (.gitignore protects it).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL application user connection (Role: app — Non-superuser, RLS enforced)
DATABASE_URL=postgresql+psycopg://app:REPLACE_WITH_STRONG_APP_PASSWORD@localhost:5432/dailyclose

# PostgreSQL migration connection (Role: postgres — Superuser to apply RLS DDL & REVOKE)
DATABASE_MIGRATION_URL=postgresql+psycopg://postgres:REPLACE_WITH_SUPERUSER_PASSWORD@localhost:5432/dailyclose

# Passwords for docker-compose and host services
DB_PASSWORD=REPLACE_WITH_STRONG_APP_PASSWORD
DB_SUPERUSER_PASSWORD=REPLACE_WITH_SUPERUSER_PASSWORD
POSTGRES_DB=dailyclose
POSTGRES_USER=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Security & Cryptography
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET_KEY

# Passphrase used by deploy/backup_nightly.sh for OpenSSL AES-256-CBC encryption
# Store this in an offline secure vault for disaster recovery.
BACKUP_PASSPHRASE=REPLACE_WITH_STRONG_OFFLINE_VAULT_BACKUP_PASSPHRASE

# ------------------------------------------------------------------------------
# 3. Application & Logging Environment
# ------------------------------------------------------------------------------
# APP_ENV: development, test, production
APP_ENV=production

# LOG_LEVEL: INFO, WARNING, ERROR (Rule 9: Never use DEBUG in production to prevent PII leakage)
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 4. Telegram Bot Adapter (aiogram 3)
# ------------------------------------------------------------------------------
# Bot token acquired from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:REPLACE_WITH_YOUR_TELEGRAM_BOT_TOKEN
